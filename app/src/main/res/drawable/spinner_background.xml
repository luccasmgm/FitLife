<?xml version="1.0" encoding="utf-8"?>
<!--
    Drawable que dá ao Spinner uma aparência de campo com borda,
    consistente com os TextInputLayout.OutlinedBox usados nos campos de texto.
    Coloque este arquivo em res/drawable/spinner_background.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="1dp"
        android:color="#D1D5DB" />

    <corners android:radius="4dp" />

    <solid android:color="@android:color/white" />
</shape>
